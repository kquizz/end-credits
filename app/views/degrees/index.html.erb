<% content_for :title, "Six Degrees" %>

<%
  person_json = ->(p) { { id: p.id, name: p.name, photo_url: p.photo_url } }
  tier_label = { "easy" => "Easy", "medium" => "Medium", "hard" => "Hard" }
%>

<div class="w-full max-w-4xl mx-auto"
     data-controller="degrees"
     data-degrees-start-value="<%= person_json.call(@start).to_json %>"
     data-degrees-target-value="<%= person_json.call(@target).to_json %>"
     data-degrees-tier-value="<%= @tier %>"
     data-degrees-people-url-value="<%= degrees_people_path %>"
     data-degrees-guess-url-value="<%= degrees_guess_path %>"
     data-degrees-game-path-value="<%= degrees_path %>">
  <%= link_to "← Home", root_path, class: "text-sm text-slate-500 hover:underline" %>
  <div class="mt-2 mb-1 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-3xl font-bold">Six Degrees</h1>
    <div class="flex flex-wrap items-center gap-2">
    <form method="get" action="<%= degrees_path %>" class="flex items-center gap-2">
      <label class="sr-only" for="tier">Difficulty</label>
      <select id="tier" name="tier" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
        <option value="">Any difficulty</option>
        <% @tiers.each do |t| %>
          <option value="<%= t %>" <%= "selected" if t == @tier %>><%= tier_label[t] %></option>
        <% end %>
      </select>
      <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white">New game</button>
    </form>
    <%= button_to "Play with a friend", degrees_rooms_path, method: :post, form_class: "contents",
                  class: "rounded-lg border border-slate-900 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100" %>
    </div>
  </div>
  <p class="text-slate-500 mb-6">Connect the two actors. Name someone who shares a credit with the end of your chain, then keep going until you reach the target. Fewer hops is better.</p>

  <div class="flex items-start justify-center gap-4 sm:gap-8">
    <% [ [ "Start", @start ], [ "Target", @target ] ].each_with_index do |(label, person), i| %>
      <% if i == 1 %>
        <span class="mt-24 text-3xl text-slate-400" aria-hidden="true">→</span>
      <% end %>
      <figure class="flex w-36 flex-col items-center rounded-xl border border-slate-200 bg-white p-4 text-center shadow-sm">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= label %></p>
        <% if person.photo_url %>
          <img src="<%= person.photo_url %>" alt="" class="h-28 w-28 rounded-full object-cover">
        <% else %>
          <div class="flex h-28 w-28 items-center justify-center rounded-full bg-slate-200 text-2xl font-semibold text-slate-600"><%= person.name.split.first(2).map { |w| w[0] }.join %></div>
        <% end %>
        <figcaption class="mt-2 font-semibold"><%= person.name %></figcaption>
      </figure>
    <% end %>
  </div>

  <section class="mt-8" aria-label="Your chain">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Your chain</h2>
    <ol data-degrees-target="chain" class="flex flex-wrap items-start gap-y-4"></ol>
  </section>

  <div data-degrees-target="win" hidden role="status"
       class="mt-6 rounded-xl border border-emerald-300 bg-emerald-50 p-5 text-center">
    <p class="text-2xl font-bold text-emerald-800">🎉 Connected!</p>
    <p data-degrees-target="score" class="mt-1 text-lg text-emerald-900"></p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
      <button type="button" data-action="degrees#share"
              class="rounded-lg bg-emerald-700 px-4 py-2 font-medium text-white">Copy share text</button>
      <a href="<%= degrees_path(tier: @tier.presence) %>" class="rounded-lg border border-emerald-700 px-4 py-2 font-medium text-emerald-800">Play again</a>
    </div>
    <p data-degrees-target="shareStatus" class="mt-2 text-sm text-emerald-800" role="status"></p>
  </div>

  <div data-degrees-target="play" class="mt-6">
    <div class="relative max-w-2xl">
      <label for="guess" class="mb-1 block text-sm font-medium text-slate-700">
        Who shares a credit with <span data-degrees-target="lastName" class="font-semibold"></span>?
      </label>
      <input id="guess" type="search" autocomplete="off" autofocus placeholder="Search an actor…"
             data-degrees-target="input" data-action="input->degrees#search keydown->degrees#key"
             class="w-full border border-slate-300 rounded-lg px-4 py-3 text-lg">
      <ul data-degrees-target="results" hidden
          class="absolute z-10 mt-1 w-full rounded-lg border border-slate-200 bg-white shadow-lg flex flex-col gap-1 p-1"></ul>
    </div>
    <p data-degrees-target="message" class="mt-2 min-h-6 text-sm text-red-700" role="status"></p>

    <fieldset class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-700">
      <legend class="sr-only">Rules for future guesses</legend>
      <label class="flex items-center gap-2">
        <input type="checkbox" checked data-degrees-target="skipSelf" class="h-4 w-4">
        Skip Self credits
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" checked data-degrees-target="skipVoice" class="h-4 w-4">
        Skip voice acting
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-degrees-target="skipMarvel" class="h-4 w-4">
        Skip Marvel
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-degrees-target="moviesOnly" class="h-4 w-4">
        Movies only
      </label>
      <span class="flex items-center gap-2">
        Years
        <input type="number" inputmode="numeric" min="1900" max="2100" placeholder="from" aria-label="From year"
               data-degrees-target="yearFrom" class="w-20 rounded-lg border border-slate-300 px-2 py-1">
        –
        <input type="number" inputmode="numeric" min="1900" max="2100" placeholder="to" aria-label="To year"
               data-degrees-target="yearTo" class="w-20 rounded-lg border border-slate-300 px-2 py-1">
      </span>
    </fieldset>
    <p class="mt-2 text-xs text-slate-500">Rules apply to your next guess.</p>
  </div>
</div>
