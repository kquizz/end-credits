<%# Shows the cast immediately; the lazy frame swaps in the full table once EGOT lookups finish. %>
<%= turbo_frame_tag "cast_table", src: cast_table_path(table_params), loading: :lazy, class: "block mt-6" do %>
  <p class="mb-2 text-sm text-slate-500 flex items-center gap-2">
    <span class="inline-block size-4 rounded-full border-2 border-slate-300 border-t-slate-600 animate-spin"></span>
    Checking awards for <%= pluralize(cast.size, "cast member") %>…
  </p>
  <table class="w-full text-left">
    <%= render "table_head" %>
    <tbody>
      <% cast.each do |member| %>
        <tr class="border-t border-slate-200">
          <td class="py-2 pr-3 font-medium"><%= member.name %></td>
          <td class="py-2 pr-3 text-slate-500"><%= member.character %></td>
          <% 4.times do %>
            <td class="py-2 text-center"><span class="inline-block h-4 w-6 rounded bg-slate-200 animate-pulse"></span></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
