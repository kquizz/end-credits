<% path = result.media_type == "movie" ? tool_path(:movie, result.id) : tool_path(:show, result.id) %>
<%= link_to path, data: { turbo_frame: "_top" },
      class: "flex items-center gap-3 p-2 rounded-lg hover:bg-slate-100" do %>
  <% if result.poster_url %>
    <%= image_tag result.poster_url, class: "w-10 h-14 rounded object-cover", loading: "lazy", alt: "" %>
  <% else %>
    <div class="w-10 h-14 rounded bg-slate-200"></div>
  <% end %>
  <div>
    <div class="font-medium"><%= result.title %></div>
    <div class="text-slate-500 text-sm">
      <%= result.media_type == "movie" ? "Movie" : "TV show" %><%= " · #{result.year}" if result.year %>
    </div>
  </div>
<% end %>
