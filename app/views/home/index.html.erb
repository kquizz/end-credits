<% content_for :title, "End Credits" %>

<section class="w-full">
  <h1 class="text-4xl font-bold tracking-tight">End Credits</h1>
  <p class="mt-2 text-slate-600">Little lookups for the things you always wonder while watching.</p>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    <% @tools.each do |tool| %>
      <li>
        <% if tool.live? %>
          <%= link_to tool.path, class: "block h-full rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-400 hover:shadow" do %>
            <%= render "home/tool_body", tool: tool %>
          <% end %>
        <% else %>
          <div class="h-full rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5 opacity-70" aria-disabled="true">
            <%= render "home/tool_body", tool: tool %>
            <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Coming soon</p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
