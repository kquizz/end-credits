<% content_for :title, "Co-star Web" %>

<div class="w-full max-w-5xl mx-auto"
     data-controller="costars"
     data-costars-preload-value="<%= (@preloaded || []).to_json %>"
     data-costars-search-url-value="<%= costars_search_path %>"
     data-costars-overlap-url-value="<%= costars_overlap_path %>"
     data-costars-watch-next-url-value="<%= costars_watch_next_path %>">
  <%= link_to "← Home", root_path, class: "text-sm text-slate-500 hover:underline" %>
  <h1 class="text-3xl font-bold mt-2 mb-1">Co-star Web</h1>
  <p class="text-slate-500 mb-6">Pick two or more TV series and see who appeared in more than one. Bigger photo, more episodes together.</p>

  <div class="relative max-w-2xl">
    <input type="search" autocomplete="off" autofocus placeholder="Search a TV series…"
           data-costars-target="input" data-action="input->costars#search"
           class="w-full border border-slate-300 rounded-lg px-4 py-3 text-lg">
    <ul data-costars-target="results" hidden
        class="absolute z-10 mt-1 w-full rounded-lg border border-slate-200 bg-white shadow-lg flex flex-col gap-1 p-1"></ul>
  </div>

  <ul data-costars-target="chips" class="mt-4 flex flex-wrap gap-2"></ul>

  <div class="mt-4 flex items-center gap-3">
    <button type="button" data-costars-target="button" data-action="costars#render" disabled
            class="rounded-lg bg-slate-900 px-4 py-2 font-medium text-white disabled:opacity-40">Find overlap</button>
    <p data-costars-target="status" class="text-sm text-slate-500" role="status"></p>
  </div>

  <div data-costars-target="controls" hidden class="mt-6 flex flex-wrap items-center gap-6">
    <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-sm font-medium" role="group" aria-label="View">
      <button type="button" data-costars-target="gridBtn" data-action="costars#showGrid" aria-pressed="true"
              class="px-3 py-1.5 bg-slate-900 text-white">Grid</button>
      <button type="button" data-costars-target="webBtn" data-action="costars#showWeb" aria-pressed="false"
              class="px-3 py-1.5 bg-white text-slate-700">Web</button>
    </div>
    <label data-costars-target="allWrap" hidden class="flex items-center gap-2 text-sm text-slate-700">
      <input type="checkbox" data-costars-target="allShows" data-action="costars#filter" class="h-4 w-4">
      Only people in every selected show
    </label>
    <label data-costars-target="minWrap" hidden class="flex items-center gap-2 text-sm text-slate-700">
      Hide people with fewer than
      <output data-costars-target="minValue" class="w-4 text-center font-semibold">1</output>
      episodes in a show
      <input type="range" min="1" max="1" step="1" value="1" data-costars-target="minEp" data-action="input->costars#filter"
             class="w-40 accent-slate-900" aria-label="Minimum episodes in a single show">
    </label>
  </div>

  <div class="relative mt-6">
    <div data-costars-target="canvas" class="flex flex-wrap items-center justify-center gap-3"></div>
    <div data-costars-target="web" hidden class="relative w-full overflow-hidden rounded-lg border border-slate-200 bg-white"></div>
    <aside data-costars-target="detail" hidden aria-label="Person details"
           class="fixed bottom-4 right-4 z-30 w-72 max-h-96 overflow-y-auto rounded-xl border border-slate-200 bg-white p-4 shadow-xl"></aside>
    <div data-costars-target="tooltip" hidden
         class="pointer-events-none fixed z-20 max-w-xs rounded-lg bg-slate-900 p-3 text-sm text-white shadow-lg"></div>
  </div>

  <details data-costars-target="watchSection" hidden class="mt-8 rounded-xl border border-slate-200 bg-white p-4">
    <summary class="cursor-pointer text-lg font-semibold">Watch next</summary>
    <p class="mt-2 text-sm text-slate-500">Other movies and shows that at least two of the people above have been in.</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-700">
      <label class="flex items-center gap-2">
        <input type="checkbox" checked data-costars-target="skipSelf" data-action="costars#watchFilter" class="h-4 w-4">
        Skip talk shows / Self credits
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" checked data-costars-target="skipVoice" data-action="costars#watchFilter" class="h-4 w-4">
        Skip voice acting
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-costars-target="skipMarvel" data-action="costars#watchFilter" class="h-4 w-4">
        Skip Marvel
      </label>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <button type="button" data-costars-target="watchBtn" data-action="costars#loadWatchNext"
              class="rounded-lg bg-slate-900 px-4 py-2 font-medium text-white disabled:opacity-40">Show watch-next</button>
      <p data-costars-target="watchStatus" class="text-sm text-slate-500" role="status"></p>
    </div>
    <ol data-costars-target="watchList" class="mt-4 flex flex-col gap-3"></ol>
  </details>
</div>
